# CareerOS Backend Environment Configuration Example
# Copy this file to .env and fill in your actual credentials locally.
# NEVER commit your actual .env file or real passwords to version control.

# Application Settings
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="CareerOS AI Backend"
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-secret-key-min-32-chars
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=100

# Authentication Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database Connection (Supabase PostgreSQL)
# Obtain this from: Supabase Dashboard > Project Settings > Database > Connection string > URI (Session pooler)
# Format: postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres?ssl=require
# If your password contains special characters (e.g. @, #, $, %, etc.), URL-encode them:
# Example: @ -> %40, # -> %23, $ -> %24, % -> %25, & -> %26, / -> %2F, : -> %3A
DATABASE_URL=postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-[YOUR_REGION].pooler.supabase.com:5432/postgres?ssl=require

# External Service Endpoints (Optional/Defaults)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
QDRANT_URL=http://qdrant:6333
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- AI Mentor / Interview Prep LLM (optional; backend only, never a NEXT_PUBLIC_ variable) ---
# Without a key the Mentor shows a setup message instead of answering. Get a key from the Anthropic Console.
# Groq (keys start with gsk_) - used when GROQ_API_KEY is set:
# GROQ_API_KEY=your-key-here
# GROQ_MODEL=openai/gpt-oss-120b
# Grok (xAI) - used when XAI_API_KEY is set:
# XAI_API_KEY=your-key-here
# XAI_MODEL=grok-3-mini
# Or Anthropic (used only if XAI_API_KEY is empty):
# ANTHROPIC_API_KEY=your-key-here
# TRAINING_LLM_MODEL=claude-haiku-5-5
# TRAINING_LLM_TIMEOUT_SECONDS=25
# MENTOR_MESSAGES_PER_MINUTE=12
